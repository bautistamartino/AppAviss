<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Aviss.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:paginas="clr-namespace:Aviss.App.Paginas"
    Shell.NavBarIsVisible="False"
    Title="Aviss">

    <!-- Inicio es la raíz; "Importar" se registra como ruta en el código (se abre encima, con el botón Atrás de Android). -->
    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate paginas:InicioPage}"
        Route="Inicio" />

</Shell>
