<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>
	<!-- Sin INTERNET ni ACCESS_NETWORK_STATE: la app es 100 % offline (constitución §1). -->
	<!-- Vibración corta al guardar y al avisar "animal repetido" (spec 003). Es un permiso normal: no pide confirmación. -->
	<uses-permission android:name="android.permission.VIBRATE" />
	<!-- Bluetooth no obligatorio: la app se instala igual en una tablet sin Bluetooth (queda la búsqueda a mano). Los permisos
	     BLUETOOTH_CONNECT y BLUETOOTH (hasta API 30) se declaran en PermisosBluetoothManifiesto.cs. -->
	<uses-feature android:name="android.hardware.bluetooth" android:required="false" />
</manifest>