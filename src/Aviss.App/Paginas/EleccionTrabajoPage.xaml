<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Aviss.App.ViewModels"
             xmlns:dto="clr-namespace:Aviss.Application.Campo;assembly=Aviss.Application"
             xmlns:conv="clr-namespace:Aviss.App.Convertidores"
             x:Class="Aviss.App.Paginas.EleccionTrabajoPage"
             x:DataType="vm:EleccionTrabajoViewModel"
             BackgroundColor="White"
             Title="Trabajar">

    <ContentPage.Resources>
        <conv:InvertirBooleanoConverter x:Key="Invertir" />

        <!-- Fila elegible: se resalta en ámbar cuando está seleccionada (alto contraste, constitución 9). -->
        <Style x:Key="FilaElegible" TargetType="Grid">
            <Setter Property="BackgroundColor" Value="{StaticResource CampoClaro}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource CampoAlerta}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- Número del paso (1, 2) en un círculo oscuro. -->
        <Style x:Key="InsigniaPaso" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource CampoPanel}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        </Style>
        <Style x:Key="NumeroPaso" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="ElegidoPaso" TargetType="Label" BasedOn="{StaticResource TextoCampo}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource CampoExito}" />
        </Style>
    </ContentPage.Resources>

    <!--
        Elegir con qué trabajar (spec 003, RF-1 y RF-2; spec 006: sin veterinario): establecimiento y rodeo
        con su avance de hoy. Dos pasos en una sola columna, para que se lea igual en vertical y en horizontal.
        Sin lógica acá: todo está en EleccionTrabajoViewModel.
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24,16" RowSpacing="12">

        <Label Grid.Row="0" Text="Elegir con qué trabajar" Style="{StaticResource TituloCuadro}" FontSize="36"
               SemanticProperties.HeadingLevel="Level1" />

        <!-- Mensajes -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border IsVisible="{Binding HayMensajeError}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="16,10">
                <Label Text="{Binding MensajeError}" TextColor="White" FontSize="22" FontAttributes="Bold"
                       SemanticProperties.Description="Mensaje de error" />
            </Border>
            <Border IsVisible="{Binding HayMensajeInfo}" BackgroundColor="{StaticResource CampoAlerta}" StrokeThickness="0" Padding="16,10">
                <Label Text="{Binding MensajeInfo}" TextColor="Black" FontSize="20" FontAttributes="Bold" />
            </Border>
        </VerticalStackLayout>

        <!-- Sin rodeos importados: se ofrece ir a importar (RF-2). -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding NoHayRodeos}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="24">
            <Label Text="No hay rodeos para trabajar." Style="{StaticResource TituloCuadro}" HorizontalTextAlignment="Center" />
            <Label Text="Primero importá el Excel de Dairy Comp de un rodeo." Style="{StaticResource TextoCampo}" FontSize="26"
                   HorizontalTextAlignment="Center" />
            <Button Text="Importar rodeo" Style="{StaticResource BotonCampo}" Command="{Binding IrAImportarCommand}" />
        </VerticalStackLayout>

        <!-- Dos pasos, uno debajo del otro -->
        <ScrollView Grid.Row="2" IsVisible="{Binding NoHayRodeos, Converter={StaticResource Invertir}}">
            <VerticalStackLayout Spacing="28">

                <!-- 1. Establecimiento -->
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="12">
                        <Border Style="{StaticResource InsigniaPaso}">
                            <Label Text="1" Style="{StaticResource NumeroPaso}" />
                        </Border>
                        <Label Text="¿En qué establecimiento?" Style="{StaticResource TituloCuadro}" FontSize="28" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding TextoEstablecimientoElegido}" Style="{StaticResource ElegidoPaso}" />
                    <CollectionView ItemsSource="{Binding Establecimientos}" SelectionMode="Single"
                                    SelectedItem="{Binding EstablecimientoSeleccionado, Mode=TwoWay}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EstablecimientoParaTrabajar">
                                <Grid Style="{StaticResource FilaElegible}" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,8" MinimumHeightRequest="72">
                                    <Label Grid.Column="0" Text="{Binding Nombre}" Style="{StaticResource TextoCampo}" FontSize="26" FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <!-- Editar el nombre: abre una capa; no cambia la elección. -->
                                    <Button Grid.Column="1" Text="Editar" Style="{StaticResource BotonCampoSecundario}" FontSize="20"
                                            HeightRequest="56" MinimumWidthRequest="110" Padding="18,0" VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EleccionTrabajoViewModel}}, Path=PedirEditarEstablecimientoCommand, x:DataType=vm:EleccionTrabajoViewModel}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Editar el nombre de este establecimiento" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 2. Rodeo, con el avance de hoy -->
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="12">
                        <Border Style="{StaticResource InsigniaPaso}">
                            <Label Text="2" Style="{StaticResource NumeroPaso}" />
                        </Border>
                        <Label Text="¿Qué rodeo?" Style="{StaticResource TituloCuadro}" FontSize="28" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding TextoRodeoElegido}" Style="{StaticResource ElegidoPaso}" />
                    <Label Text="Elegí primero el establecimiento." Style="{StaticResource TextoCampo}" TextColor="{StaticResource Gray600}"
                           IsVisible="{Binding FaltaEstablecimiento}" />
                    <CollectionView ItemsSource="{Binding Rodeos}" SelectionMode="Single"
                                    SelectedItem="{Binding RodeoSeleccionado, Mode=TwoWay}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:RodeoParaTrabajarDto">
                                <Grid Style="{StaticResource FilaElegible}" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8" MinimumHeightRequest="72">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding RodeoNombre}" Style="{StaticResource TextoCampo}" FontSize="26" FontAttributes="Bold" />
                                        <Label Text="{Binding Avance.Porcentaje, StringFormat='Hoy: {0} % procesado'}" Style="{StaticResource TextoCampo}"
                                               FontSize="20" />
                                        <Label Text="{Binding Avance.Pendientes, StringFormat='Faltan {0} vacas'}" Style="{StaticResource TextoCampo}"
                                               FontSize="18" TextColor="{StaticResource Gray600}" />
                                    </VerticalStackLayout>
                                    <!-- Botón chico para resetear el rodeo a 0 (solo para pruebas): pide dos confirmaciones. -->
                                    <Button Grid.Column="1" Text="↺ A 0" FontSize="14" HeightRequest="36" MinimumWidthRequest="0" Padding="10,0"
                                            BackgroundColor="#B00020" TextColor="White" CornerRadius="8" VerticalOptions="Start"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EleccionTrabajoViewModel}}, Path=PedirReseteoCommand, x:DataType=vm:EleccionTrabajoViewModel}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Resetear este rodeo a como se subió el Excel" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Abajo: qué falta, volver y empezar -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
            <Label Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding QueFalta}" IsVisible="{Binding FaltaAlgo}"
                   Style="{StaticResource TextoCampo}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource CampoPeligro}"
                   HorizontalTextAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="0" Text="Volver" Style="{StaticResource BotonCampoSecundario}" Command="{Binding VolverAlInicioCommand}" />
            <Button Grid.Row="1" Grid.Column="1" Text="Empezar a trabajar" Style="{StaticResource BotonCampo}" BackgroundColor="{StaticResource CampoExito}"
                    Command="{Binding EmpezarCommand}"
                    SemanticProperties.Hint="Abre la pantalla de trabajo con el rodeo elegido" />
        </Grid>

        <!-- Resetear un rodeo: dos preguntas seguidas. Solo la segunda hace el cambio. -->
        <Grid Grid.RowSpan="4" Margin="-24,-16" IsVisible="{Binding HayReseteo}" BackgroundColor="{StaticResource CampoVelo}" Padding="16">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <!-- Primera pregunta -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding EsPrimerPasoReseteo}">
                        <Label Text="¿Resetear el rodeo?" Style="{StaticResource TituloCuadro}" FontSize="26" />
                        <Label Text="{Binding NombreRodeoAResetear}" Style="{StaticResource TextoCampo}" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Vuelve a quedar como cuando subiste el Excel: el avance y lo cargado de este rodeo (marcas, tactos, mangas) dejan de verse. Lo anterior queda guardado, pero oculto."
                               Style="{StaticResource TextoCampo}" FontSize="18" />
                        <Button Text="Sí, seguir" Style="{StaticResource BotonCampoPeligro}" HeightRequest="56" FontSize="20"
                                Command="{Binding ConfirmarPrimerPasoReseteoCommand}" />
                        <Button Text="Cancelar" Style="{StaticResource BotonCampoSecundario}" HeightRequest="52" FontSize="20"
                                Command="{Binding CancelarReseteoCommand}" />
                    </VerticalStackLayout>
                    <!-- Segunda pregunta -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding EsSegundoPasoReseteo}">
                        <Label Text="¿Estás seguro?" Style="{StaticResource TituloCuadro}" FontSize="26" TextColor="{StaticResource CampoPeligro}" />
                        <Label Text="{Binding NombreRodeoAResetear, StringFormat='Se resetea «{0}». No se puede volver atrás desde la app.'}"
                               Style="{StaticResource TextoCampo}" FontSize="20" FontAttributes="Bold" />
                        <Button Text="Sí, resetear" Style="{StaticResource BotonCampoPeligro}" HeightRequest="56" FontSize="20"
                                IsEnabled="{Binding EstaReseteando, Converter={StaticResource Invertir}}"
                                Command="{Binding ConfirmarReseteoCommand}" />
                        <Button Text="No, cancelar" Style="{StaticResource BotonCampoSecundario}" HeightRequest="52" FontSize="20"
                                Command="{Binding CancelarReseteoCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Editar el nombre de un establecimiento: escribir y Guardar o Cancelar. Un error (vacío, repetido) se ve acá y la capa queda abierta. -->
        <Grid Grid.RowSpan="4" Margin="-24,-16" IsVisible="{Binding HayEdicionEstablecimiento}" BackgroundColor="{StaticResource CampoVelo}" Padding="16">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Start" Margin="0,80,0,0">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Editar establecimiento" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <Label Text="Nombre" Style="{StaticResource TextoCampo}" FontSize="20" FontAttributes="Bold" />
                    <Entry Text="{Binding NombreEditado, Mode=TwoWay}" Style="{StaticResource EntradaCampo}" FontSize="24" HeightRequest="64"
                           MaxLength="100" ReturnType="Done" ReturnCommand="{Binding GuardarEdicionEstablecimientoCommand}"
                           SemanticProperties.Description="Nombre del establecimiento" />
                    <Border IsVisible="{Binding HayMensajeErrorEdicion}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="14,10">
                        <Label Text="{Binding MensajeErrorEdicion}" TextColor="White" FontSize="20" FontAttributes="Bold" />
                    </Border>
                    <Button Text="Guardar" Style="{StaticResource BotonCampo}" HeightRequest="60" FontSize="22"
                            BackgroundColor="{StaticResource CampoExito}"
                            IsEnabled="{Binding EstaGuardandoEdicion, Converter={StaticResource Invertir}}"
                            Command="{Binding GuardarEdicionEstablecimientoCommand}" />
                    <Button Text="Cancelar" Style="{StaticResource BotonCampoSecundario}" HeightRequest="60" FontSize="22"
                            Command="{Binding CancelarEdicionEstablecimientoCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
