<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Aviss.App.ViewModels"
             x:Class="Aviss.App.Paginas.MovimientosPage"
             x:DataType="vm:MovimientosViewModel"
             BackgroundColor="White"
             Title="Últimos movimientos">

    <!-- Los 50 movimientos más recientes del rodeo, con "Deshacer" donde corresponda (spec 003, RF-28 y RF-29). -->
    <Grid RowDefinitions="Auto,Auto,*" Padding="24,16" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Grid.Column="0" Text="Volver" Style="{StaticResource BotonCampoSecundario}" Clicked="OnVolverClicked" />
            <Label Grid.Column="1" Text="Últimos movimientos" Style="{StaticResource TituloCuadro}" FontSize="36" VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border IsVisible="{Binding HayMensajeError}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="16,10">
                <Label Text="{Binding MensajeError}" TextColor="White" FontSize="22" FontAttributes="Bold" />
            </Border>
            <Border IsVisible="{Binding HayMensajeInfo}" BackgroundColor="{StaticResource CampoAlerta}" StrokeThickness="0" Padding="16,10">
                <Label Text="{Binding MensajeInfo}" TextColor="Black" FontSize="22" FontAttributes="Bold" />
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Movimientos}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Todavía no hay movimientos en este rodeo." Style="{StaticResource TextoCampo}" FontSize="26"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:MovimientoItem">
                    <Grid ColumnDefinitions="110,220,*,Auto" ColumnSpacing="16" Padding="16,10" Margin="0,0,0,8"
                          BackgroundColor="{StaticResource CampoClaro}" MinimumHeightRequest="72">
                        <Label Grid.Column="0" Text="{Binding Hora}" Style="{StaticResource TextoCampo}" FontSize="26" FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Tipo}" Style="{StaticResource TextoCampo}" FontSize="18" TextColor="{StaticResource Gray600}" />
                            <Label Text="{Binding Titulo}" Style="{StaticResource TextoCampo}" FontSize="28" FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Anulado}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                            <Label Text="{Binding Detalle}" Style="{StaticResource TextoCampo}" FontSize="22" />
                            <Label Text="{Binding TextoCierre}" IsVisible="{Binding HayTextoCierre}" Style="{StaticResource TextoCampo}"
                                   FontSize="22" FontAttributes="Bold" />
                            <Label Text="{Binding Veterinario}" Style="{StaticResource TextoCampo}" FontSize="18" TextColor="{StaticResource Gray600}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="3" Text="Deshacer" Style="{StaticResource BotonCampoAlerta}" HeightRequest="64"
                                IsVisible="{Binding PuedeDeshacer}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MovimientosViewModel}}, Path=DeshacerCommand, x:DataType=vm:MovimientosViewModel}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
