<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Aviss.App.ViewModels"
             x:Class="Aviss.App.Paginas.InicioPage"
             x:DataType="vm:InicioViewModel"
             Title="Aviss">

    <ScrollView>
        <VerticalStackLayout x:Name="Contenido" Padding="32" Spacing="32" MaximumWidthRequest="720" VerticalOptions="Center">
            <Label Text="Aviss"
                   FontSize="40" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Tacto reproductivo en el tambo"
                   FontSize="22" />

            <!-- Botones grandes, de campo (constitución 9): alto 72, texto 24. -->
            <Button Text="Trabajar"
                    FontSize="24" FontAttributes="Bold"
                    HeightRequest="72"
                    Command="{Binding TrabajarCommand}"
                    SemanticProperties.Hint="Elegir establecimiento y rodeo y empezar el tacto" />
            <Button Text="Importar rodeo"
                    FontSize="24" FontAttributes="Bold"
                    HeightRequest="72"
                    Command="{Binding ImportarRodeoCommand}"
                    SemanticProperties.Hint="Elegir el Excel de Dairy Comp para cargar un rodeo" />
            <Button Text="Exportar"
                    FontSize="24" FontAttributes="Bold"
                    HeightRequest="72"
                    Command="{Binding ExportarCommand}"
                    SemanticProperties.Hint="Generar el archivo con los tactos para volver a Dairy Comp" />

            <!-- Solo compilación DEBUG (el código lo muestra): diagnóstico del bastón, spike de la spec 008. -->
            <Button x:Name="BotonDiagnostico" Text="Diagnóstico del bastón"
                    IsVisible="False"
                    FontSize="24" FontAttributes="Bold"
                    HeightRequest="72"
                    BackgroundColor="{StaticResource CampoSecundario}" TextColor="White"
                    SemanticProperties.Hint="Herramienta de prueba para ver qué manda el bastón por Bluetooth" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
