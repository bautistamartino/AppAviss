<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Aviss.App.ViewModels"
             xmlns:ctl="clr-namespace:Aviss.App.Controles"
             xmlns:conv="clr-namespace:Aviss.App.Convertidores"
             xmlns:dto="clr-namespace:Aviss.Application.Campo;assembly=Aviss.Application"
             x:Class="Aviss.App.Paginas.TrabajoPage"
             x:DataType="vm:TrabajoViewModel"
             BackgroundColor="White"
             Title="Trabajo">

    <ContentPage.Resources>
        <conv:InvertirBooleanoConverter x:Key="Invertir" />
        <conv:EventoFichaFechaConverter x:Key="FechaEvento" />
        <conv:FechaUtcALocalConverter x:Key="FechaLocal" />
        <conv:EstadoActualConverter x:Key="EstadoActual" />
    </ContentPage.Resources>

    <!--
        Pantalla de trabajo (spec 003, T4). Toda la lógica está en TrabajoViewModel: acá solo se muestra y se enlazan
        los botones. Los avisos y cuadros son CAPAS dentro de esta misma página (no DisplayAlert), así el ViewModel
        decide qué hacer con las lecturas que llegan mientras hay una capa abierta (RF-19).
        Las capas llevan un TapGestureRecognizer vacío: en Android hace que "se coman" los toques y no lleguen a lo que
        está debajo.
    -->
    <Grid>

        <!-- *** PANTALLA PRINCIPAL *** -->
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

            <!-- Encabezado contraíble (RF-3). La barra de arriba se ve siempre: flechita para contraer o abrir, el ID y el CVET de la
                 vaca abierta (o el rodeo si no hay) y el contador de la manga. Abierta, muestra además el rodeo, el avance, los
                 horarios de la primera y la última vaca y los botones de cierre. -->
            <Border Grid.Row="0" BackgroundColor="{StaticResource CampoPanel}" StrokeThickness="0" Padding="8,4,12,4">
                <VerticalStackLayout Spacing="6">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <!-- Esquina de arriba a la izquierda: el engranaje (configuración, de un solo toque) y, bien separada para no tocar
                             una por la otra, la flechita que contrae o abre los datos. -->
                        <HorizontalStackLayout Grid.Column="0" Spacing="26" VerticalOptions="Center">
                            <Button Text="⚙" BackgroundColor="#78909C" TextColor="White" FontSize="22" CornerRadius="8"
                                    WidthRequest="40" HeightRequest="40" MinimumWidthRequest="0" Padding="0" VerticalOptions="Center"
                                    Command="{Binding AbrirConfiguracionCommand}"
                                    SemanticProperties.Description="Configuración" />
                            <Button Text="{Binding TextoFlecha}" BackgroundColor="Transparent" TextColor="White" FontSize="22"
                                    WidthRequest="44" HeightRequest="44" MinimumWidthRequest="0" Padding="0" VerticalOptions="Center"
                                    Command="{Binding AlternarCabeceraCommand}"
                                    SemanticProperties.Description="Contraer o mostrar los datos de arriba" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding TituloBarra}" Style="{StaticResource TextoCampoClaro}" FontSize="22" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    </Grid>

                    <!-- Lo que se contrae -->
                    <VerticalStackLayout Spacing="6" Padding="4,0,0,2" IsVisible="{Binding CabeceraAbierta}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding NombreRodeo}" Style="{StaticResource TextoCampoClaro}" FontSize="20" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding NombreEstablecimiento}" Style="{StaticResource TextoCampoClaro}" FontSize="14"
                                       TextColor="{StaticResource Gray200}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <!-- El contador de la manga ("Manga 3 · 7/10"). Tocarlo abre el cuadro para poner cuántas vacas entran. Se pone
                                 verde cuando está completa (10/10) y rojo cuando sobran (11/10). -->
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="Transparent" Padding="4,2" VerticalOptions="Center" IsVisible="{Binding UsaMangas}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AbrirCantidadMangaCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding TextoManga}" Style="{StaticResource ContadorManga}" FontSize="22" HorizontalTextAlignment="End"
                                       SemanticProperties.Hint="Tocá para poner cuántas vacas entran en esta manga">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding MangaCompleta}" Value="True">
                                            <Setter Property="TextColor" Value="#69F0AE" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding MangaExcedida}" Value="True">
                                            <Setter Property="TextColor" Value="#FF5252" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>

                        <Label Text="{Binding TextoAvance}" Style="{StaticResource TextoCampoClaro}" FontSize="14" TextColor="{StaticResource Gray200}" />
                        <Label Text="{Binding TextoHorarios}" Style="{StaticResource TextoCampoClaro}" FontSize="16" FontAttributes="Bold" />

                        <!-- Cada vez que entra una manga se pone cuántas vacas son (también se puede tocando el contador de arriba). -->
                        <Button Text="Cantidad de vacas de esta manga" Style="{StaticResource BotonCampoSecundario}" FontSize="16" HeightRequest="40"
                                Padding="10,0" IsVisible="{Binding UsaMangas}" Command="{Binding AbrirCantidadMangaCommand}" />

                        <!-- Cierre de manga y fin del tacto, lado a lado. -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding UsaMangas}">
                            <Button Grid.Column="0" Text="Finalizar manga" Style="{StaticResource BotonCampo}" FontSize="17" HeightRequest="44"
                                    Padding="6,0" Command="{Binding FinalizarMangaCommand}" />
                            <Button Grid.Column="1" Text="Terminar el tacto" Style="{StaticResource BotonCampoPeligro}" FontSize="17" HeightRequest="44"
                                    Padding="6,0" Command="{Binding TerminarElTactoCommand}" />
                        </Grid>

                        <!-- Sin control por manga: solo "Terminar el tacto", que termina todo el trabajo, a todo el ancho. -->
                        <Button Text="Terminar el tacto" Style="{StaticResource BotonCampoPeligro}" FontSize="17" HeightRequest="44" Padding="6,0"
                                IsVisible="{Binding UsaMangas, Converter={StaticResource Invertir}}" Command="{Binding TerminarElTactoCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Mensajes (error en rojo, información en ámbar) -->
            <VerticalStackLayout Grid.Row="1" Spacing="0">
                <Border IsVisible="{Binding HayMensajeError}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="20,12">
                    <Label Text="{Binding MensajeError}" TextColor="White" FontSize="24" FontAttributes="Bold"
                           SemanticProperties.Description="Mensaje de error" />
                </Border>
                <Border IsVisible="{Binding HayMensajeInfo}" BackgroundColor="{StaticResource CampoAlerta}" StrokeThickness="0" Padding="20,12">
                    <Label Text="{Binding MensajeInfo}" TextColor="Black" FontSize="22" FontAttributes="Bold" />
                </Border>

                <!-- Botonera de espera (spec 004, RF-2): las primeras vacas en espera, con la caravana y cuánto hace que esperan, y "+N" si
                     hay más. Va en una sola fila, chica y con desplazamiento horizontal por si no entran; con 0 esperas no se ve. Cada
                     botón mide 44 dp de alto. Al estar arriba, no tapa los botones de la ficha (que están abajo). -->
                <Border IsVisible="{Binding HayEsperas}" BackgroundColor="{StaticResource CampoClaro}" StrokeThickness="0" Padding="8,4">
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="En espera:" Style="{StaticResource TextoCampo}" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding EsperasBotonera}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EsperaItem">
                                        <Button Text="{Binding TextoBotonera}" Style="{StaticResource BotonCampoAlerta}" FontSize="16"
                                                HeightRequest="44" MinimumWidthRequest="64" Padding="12,0" CornerRadius="8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrabajoViewModel}}, Path=AbrirEsperaCommand, x:DataType=vm:TrabajoViewModel}"
                                                CommandParameter="{Binding .}"
                                                SemanticProperties.Hint="Abrir la ficha de esta vaca en espera" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            <Button Text="{Binding TextoMasEsperas}" IsVisible="{Binding HayMasEsperas}" Style="{StaticResource BotonCampoSecundario}"
                                    FontSize="16" HeightRequest="44" MinimumWidthRequest="52" Padding="12,0" CornerRadius="8"
                                    Command="{Binding AbrirListaEsperaCommand}"
                                    SemanticProperties.Hint="Ver todas las vacas en espera" />
                        </HorizontalStackLayout>
                    </ScrollView>
                </Border>
            </VerticalStackLayout>

            <!-- Centro -->
            <Grid Grid.Row="2">

                <!-- Esperando la próxima lectura: lo último que se guardó. -->
                <VerticalStackLayout IsVisible="{Binding EstaEsperando}"
                                     VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="24">
                    <Label Text="Esperando la próxima caravana" Style="{StaticResource TituloCuadro}" FontSize="34"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Leé una caravana con el bastón o buscala a mano abajo." Style="{StaticResource TextoCampo}" FontSize="22"
                           TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" />
                    <Border IsVisible="{Binding HayUltimoGuardado}" BackgroundColor="{StaticResource CampoClaro}" StrokeThickness="0" Padding="24,16">
                        <Label Text="{Binding UltimoGuardado, StringFormat='Último: {0}'}" Style="{StaticResource TextoCampo}" FontSize="28"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </Border>
                    <!-- Tras una vaca con CVET 0 (que no entra en tacto): un botón para mirar su ficha, por si se quiere saber algo de ella. -->
                    <Button Text="{Binding TextoVerFichaSinTacto}" Style="{StaticResource BotonCampoSecundario}" FontSize="20" HeightRequest="56"
                            IsVisible="{Binding HayVerFichaSinTacto}" Command="{Binding VerFichaSinTactoCommand}"
                            SemanticProperties.Hint="Abre la ficha de la última vaca que no entró en tacto, solo para mirar" />
                </VerticalStackLayout>

                <!-- Ficha de la vaca, como en el Daily: título con el ID y el CVET, Evento y Observación lado a lado, pestañas
                     Datos e Historial y la barra de abajo con Saltar y Entrar (RF-13 a RF-15). -->
                <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding HayFicha}">

                    <!-- El ID y el CVET (el motivo del tacto) están en la barra de arriba de la pantalla, que se ve siempre. Una vaca con
                         CVET 0 abierta con "Ver ficha" lo avisa en rojo. -->
                    <VerticalStackLayout Grid.Row="0">
                        <Border IsVisible="{Binding NoEntraEnTacto}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="14,6">
                            <Label Text="No entra en tacto (CVET 0)" TextColor="White" FontSize="20" FontAttributes="Bold" />
                        </Border>
                        <!-- Cartel de la vaca que viene de la espera (RF-3): acá "Saltar" la saca de la espera sin guardar nada. -->
                        <Border IsVisible="{Binding EsEsperaAbierta}" BackgroundColor="{StaticResource CampoAlerta}" StrokeThickness="0" Padding="14,6">
                            <Label Text="En espera: Saltar la saca de la lista" TextColor="Black" FontSize="18" FontAttributes="Bold" />
                        </Border>
                        <!-- Franja de rechazo (RF-15): solo se ve si la vaca tiene un rechazo vigente (lo decide el ViewModel). -->
                        <Border IsVisible="{Binding HayRechazoVigente}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="14,6">
                            <Label Text="{Binding TextoRechazoVigente}"
                                   TextColor="White" FontSize="20" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Evento y Observación: tocar cada casillero abre su lista o su texto. Nada se guarda hasta "Entrar". -->
                    <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="10,8,10,4" IsVisible="{Binding PuedeAgregarEventos}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Evento" Style="{StaticResource TextoCampo}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                            <Label Grid.Column="1" Text="Observación" Style="{StaticResource TextoCampo}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="{Binding TextoEventoElegido}" Style="{StaticResource BotonCampoSecundario}" FontSize="17"
                                    HeightRequest="68" MinimumWidthRequest="0" Padding="8,2" LineBreakMode="WordWrap"
                                    Command="{Binding AbrirEventosCommand}"
                                    SemanticProperties.Hint="Elegir el evento de esta vaca" />
                            <Button Grid.Column="1" Text="{Binding TextoCasilleroObservacion}" Style="{StaticResource BotonCampoSecundario}" FontSize="18"
                                    HeightRequest="68" MinimumWidthRequest="0" Padding="8,0" LineBreakMode="TailTruncation"
                                    Command="{Binding AbrirObservacionCommand}"
                                    SemanticProperties.Hint="Opcional: escribir una observación" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Pestañas y su contenido -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="2" Padding="0,4,0,0">
                            <Button Grid.Column="0" Text="Datos" Style="{StaticResource BotonCampoSecundario}" FontSize="18" HeightRequest="48" CornerRadius="0"
                                    Command="{Binding VerDatosCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding HayDatos}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource CampoPanel}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" Text="Historial" Style="{StaticResource BotonCampoSecundario}" FontSize="18" HeightRequest="48" CornerRadius="0"
                                    Command="{Binding VerHistorialCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding HayDatos}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource CampoPanel}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>

                        <!-- Datos: una tabla "dato → valor" con renglones separados. Trae todas las columnas del Excel (DCC, DDUC, LECHE...). -->
                        <ScrollView Grid.Row="1" IsVisible="{Binding HayDatos}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilasDatos}" Padding="10,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:CampoFichaDto">
                                        <VerticalStackLayout>
                                            <Grid ColumnDefinitions="110,*" ColumnSpacing="10" Padding="0,8">
                                                <Label Grid.Column="0" Text="{Binding Nombre}" Style="{StaticResource TextoCampo}" FontSize="20" FontAttributes="Bold"
                                                       TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Valor}" Style="{StaticResource TextoCampo}" FontSize="24" FontAttributes="Bold"
                                                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>

                        <!-- Historial cronológico (RF-14). -->
                        <ScrollView Grid.Row="1" IsVisible="{Binding MostrarHistorial}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ficha.Historial}" Spacing="10" Padding="14,10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:EventoFichaDto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Titulo}" Style="{StaticResource TextoCampo}" FontSize="20" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Anulado}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding ., Converter={StaticResource FechaEvento}}" Style="{StaticResource TextoCampo}"
                                                   FontSize="17" TextColor="{StaticResource Gray600}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>

                    <!-- Barra de abajo: Saltar (cierra sin guardar, sirve para solo mirar los datos) y Entrar (guarda). -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*,2*" ColumnSpacing="8" Padding="10,6" BackgroundColor="{StaticResource CampoClaro}">
                        <Button Grid.Column="0" Text="Saltar" Style="{StaticResource BotonCampoSecundario}" FontSize="20" HeightRequest="56" MinimumWidthRequest="0"
                                Command="{Binding CerrarFichaCommand}"
                                SemanticProperties.Hint="Cerrar la ficha sin guardar nada" />
                        <!-- "En espera" (RF-1): deja la vaca para después, sin guardar tacto. Solo si entra en tacto y no viene ya de la espera. -->
                        <Button Grid.Column="1" Text="En espera" Style="{StaticResource BotonCampoAlerta}" FontSize="20" HeightRequest="56" MinimumWidthRequest="0"
                                Padding="4,0" IsVisible="{Binding PuedePonerEnEspera}" Command="{Binding PonerEnEsperaCommand}"
                                SemanticProperties.Hint="Dejar esta vaca en espera para atenderla después" />
                        <Button Grid.Column="2" Text="Entrar" Style="{StaticResource BotonCampo}" BackgroundColor="{StaticResource CampoExito}" FontSize="22"
                                HeightRequest="56" IsVisible="{Binding PuedeAgregarEventos}" Command="{Binding EntrarCommand}"
                                SemanticProperties.Hint="Guardar el evento elegido para esta vaca" />
                    </Grid>
                </Grid>

            </Grid>

            <!-- El aviso de 5 segundos con "Deshacer" va justo arriba de la barra de búsqueda: chico y centrado (RF-27). Mientras
                 se ve, empuja un poco hacia arriba lo que tiene encima; cuando se va, todo vuelve a su lugar. -->
            <Border Grid.Row="3" IsVisible="{Binding HayAvisoDeshacer}" HorizontalOptions="Center" Margin="0,4,0,4"
                    BackgroundColor="#212121" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,3">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="{Binding AvisoDeshacer.Texto}" TextColor="White" FontSize="14" FontAttributes="Bold"
                           VerticalOptions="Center" MaximumWidthRequest="200" LineBreakMode="TailTruncation" />
                    <Button Text="Deshacer" Style="{StaticResource BotonCampoAlerta}" FontSize="14" HeightRequest="32" MinimumWidthRequest="0"
                            Padding="10,0" CornerRadius="8" VerticalOptions="Center" Command="{Binding DeshacerAvisoCommand}" />
                </HorizontalStackLayout>
            </Border>

            <!-- Abajo: búsqueda manual (teclado numérico) y "Últimos movimientos" (RF-23). -->
            <Grid Grid.Row="4" BackgroundColor="{StaticResource CampoClaro}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Padding="10,4">
                    <Entry x:Name="CampoBusqueda" Grid.Column="0" Style="{StaticResource EntradaCampo}" Keyboard="Numeric" FontSize="20" HeightRequest="48"
                           Placeholder="Caravana a mano" ReturnType="Search"
                           Text="{Binding TextoBusqueda}" ReturnCommand="{Binding BuscarCommand}" Completed="OnBuscarTerminado"
                           SemanticProperties.Description="Número de caravana para buscar a mano" />
                    <Button Grid.Column="1" Text="Buscar" Style="{StaticResource BotonCampo}" FontSize="17" HeightRequest="48"
                            MinimumWidthRequest="0" Padding="14,0" Command="{Binding BuscarCommand}" Clicked="OnBuscarTerminado" />
                    <Button Grid.Column="2" Text="Movimientos" Style="{StaticResource BotonCampoSecundario}" FontSize="17" HeightRequest="48"
                            MinimumWidthRequest="0" Padding="14,0" Command="{Binding MostrarMovimientosCommand}"
                            SemanticProperties.Hint="Muestra los últimos movimientos y permite deshacer" />
                    <!-- Simulador: un botoncito sin texto que simula una lectura de caravana (solo existe donde hay simulador). -->
                    <Button Grid.Column="3" Style="{StaticResource BotonCampoSecundario}" WidthRequest="30" HeightRequest="30" MinimumWidthRequest="0"
                            Padding="0" CornerRadius="15" VerticalOptions="Center" IsVisible="{Binding HaySimulador}"
                            Command="{Binding SimularExistenteCommand}"
                            SemanticProperties.Description="Simular la lectura de una caravana" />
                </Grid>
            </Grid>
        </Grid>

        <!-- *** CAPAS (de abajo hacia arriba) *** -->

        <!-- "Animal repetido" / "Ya pasó" (RF-22) -->
        <Grid IsVisible="{Binding HayAviso}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="6" Stroke="{StaticResource CampoAlerta}" Padding="18,16"
                    HorizontalOptions="Fill" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding AvisoTitulo}" Style="{StaticResource TituloCuadro}" FontSize="30"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding AvisoCaravana}" Style="{StaticResource CaravanaGrande}" FontSize="72"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding AvisoDetalle}" Style="{StaticResource TextoCampo}" FontSize="26"
                           HorizontalTextAlignment="Center" />
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10" Margin="0,12,0,0">
                        <Button Grid.Row="0" Text="Ver ficha" Style="{StaticResource BotonCampo}" Command="{Binding VerFichaCommand}" />
                        <Button Grid.Row="1" Text="Seguir" Style="{StaticResource BotonCampoSecundario}" Command="{Binding SeguirCommand}" />
                        <Button Grid.Row="2" Text="Corregir" Style="{StaticResource BotonCampoPeligro}"
                                IsVisible="{Binding PuedeCorregir}" Command="{Binding CorregirCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- "¿Deshacer lo último de esta vaca?" (confirmación de Corregir) -->
        <Grid IsVisible="{Binding HayConfirmarCorregir}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Center"
                   >
                <VerticalStackLayout Spacing="20">
                    <Label Text="{Binding TextoCorregir}" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Button Grid.Row="0" Text="Sí, deshacer" Style="{StaticResource BotonCampoPeligro}" Command="{Binding ConfirmarCorregirCommand}" />
                        <Button Grid.Row="1" Text="No" Style="{StaticResource BotonCampoSecundario}" Command="{Binding CancelarCorregirCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- "Caravana no encontrada" (RF-24): no se guardó nada -->
        <Grid IsVisible="{Binding HayNoEncontrada}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Center"
                   >
                <VerticalStackLayout Spacing="16">
                    <Label Text="Caravana no encontrada" Style="{StaticResource TituloCuadro}" FontSize="30" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding CodigoNoEncontrado}" Style="{StaticResource CaravanaGrande}" FontSize="52"
                           HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                    <Label Text="No se guardó nada. Revisá el número en el bastón o buscala a mano." Style="{StaticResource TextoCampo}" FontSize="24"
                           HorizontalTextAlignment="Center" />
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10" Margin="0,8,0,0">
                        <Button Grid.Row="0" Text="Buscar a mano" Style="{StaticResource BotonCampo}" Command="{Binding BuscarAManoCommand}" />
                        <Button Grid.Row="1" Text="Cerrar" Style="{StaticResource BotonCampoSecundario}" Command="{Binding CerrarNoEncontradaCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>


        <!-- Verificación de "Finalizar manga" / "Terminar el tacto" (RF-6): contador y caravanas -->
        <Grid IsVisible="{Binding HayVerificacion}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Center"
                   >
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding ResumenManga.NumeroManga, StringFormat='Verificar la manga {0}'}" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <Label Text="{Binding ResumenManga.Contador, StringFormat='Aviss contó {0} vacas. ¿Coincide con las que pasaron?'}"
                           Style="{StaticResource TextoCampo}" FontSize="22" FontAttributes="Bold" />
                    <!-- Si se puso la cantidad de la manga: lo esperado contra lo marcado, para no cerrarla con una vaca sin marcar. -->
                    <Border IsVisible="{Binding HayMetaVerificacion}" BackgroundColor="{StaticResource CampoAlerta}" StrokeThickness="0" Padding="12,8">
                        <Label Text="{Binding TextoMetaVerificacion}" TextColor="Black" FontSize="20" FontAttributes="Bold" />
                    </Border>
                    <ScrollView HeightRequest="170" BackgroundColor="{StaticResource CampoClaro}">
                        <FlexLayout BindableLayout.ItemsSource="{Binding ResumenManga.Caravanas}" Wrap="Wrap" Direction="Row" Padding="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" Style="{StaticResource TextoCampo}" FontSize="22" Margin="8,4" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </ScrollView>
                    <Border IsVisible="{Binding HayMensajeCuadro}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="16,10">
                        <Label Text="{Binding MensajeCuadro}" TextColor="White" FontSize="22" FontAttributes="Bold" />
                    </Border>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Button Grid.Row="0" Text="Coincide" Style="{StaticResource BotonCampo}" BackgroundColor="{StaticResource CampoExito}"
                                Command="{Binding CoincideCommand}" />
                        <Button Grid.Row="1" Text="No coincide" Style="{StaticResource BotonCampoPeligro}" Command="{Binding NoCoincideCommand}" />
                        <Button Grid.Row="2" Text="Volver a corregir" Style="{StaticResource BotonCampoSecundario}" Command="{Binding VolverACorregirCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Cantidad real (RF-6): teclado numérico -->
        <Grid IsVisible="{Binding HayCantidadReal}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Center"
                   >
                <VerticalStackLayout Spacing="16">
                    <Label Text="¿Cuántas vacas pasaron realmente?" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <Entry Style="{StaticResource EntradaCampo}" Keyboard="Numeric" MaxLength="5"
                           Text="{Binding CantidadRealTexto}" Placeholder="Cantidad real" />
                    <Border IsVisible="{Binding HayMensajeCuadro}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="16,10">
                        <Label Text="{Binding MensajeCuadro}" TextColor="White" FontSize="22" FontAttributes="Bold" />
                    </Border>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Button Grid.Row="0" Text="Confirmar cantidad" Style="{StaticResource BotonCampo}" Command="{Binding ConfirmarCantidadRealCommand}" />
                        <Button Grid.Row="1" Text="Volver a corregir" Style="{StaticResource BotonCampoSecundario}" Command="{Binding VolverACorregirCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Segunda confirmación de "Terminar el tacto" (RF-7) -->
        <Grid IsVisible="{Binding HaySegundaConfirmacion}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Center"
                   >
                <VerticalStackLayout Spacing="20">
                    <!-- Con el control por manga prendido y una manga abierta, se advierte cuál es antes de terminar. -->
                    <Border IsVisible="{Binding HayAdvertenciaMangaAbierta}" BackgroundColor="{StaticResource CampoAlerta}" StrokeThickness="0" Padding="14,10">
                        <Label Text="{Binding AdvertenciaMangaAbierta}" TextColor="Black" FontSize="20" FontAttributes="Bold" />
                    </Border>
                    <!-- Aviso de vacas en espera (RF-10): no impide terminar. -->
                    <Border IsVisible="{Binding HayEsperaPendiente}" BackgroundColor="{StaticResource CampoAlerta}" StrokeThickness="0" Padding="14,10">
                        <Label Text="{Binding TextoEsperaPendiente}" TextColor="Black" FontSize="20" FontAttributes="Bold" />
                    </Border>
                    <Label Text="{Binding TextoSegundaConfirmacion}" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <Border IsVisible="{Binding HayMensajeCuadro}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="16,10">
                        <Label Text="{Binding MensajeCuadro}" TextColor="White" FontSize="22" FontAttributes="Bold" />
                    </Border>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Button Grid.Row="0" Text="Sí, terminar" Style="{StaticResource BotonCampoPeligro}" Command="{Binding ConfirmarTerminarCommand}" />
                        <Button Grid.Row="1" Text="No, seguir trabajando" Style="{StaticResource BotonCampoSecundario}" Command="{Binding NoTerminarCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Resumen de "Terminar el tacto" con "Deshacer" (RF-7): pantalla completa -->
        <Grid IsVisible="{Binding HayResumenTerminado}" BackgroundColor="White" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="18" MaximumWidthRequest="600">
                <Label Text="Tacto terminado" Style="{StaticResource TituloCuadro}" FontSize="34" HorizontalTextAlignment="Center" />
                <Label Text="{Binding TextoResumenTerminado}" Style="{StaticResource TextoCampo}" FontSize="22" HorizontalTextAlignment="Center" />
                <Border IsVisible="{Binding HayMensajeError}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="16,10">
                    <Label Text="{Binding MensajeError}" TextColor="White" FontSize="22" FontAttributes="Bold" />
                </Border>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Button Grid.Row="0" Text="Deshacer" Style="{StaticResource BotonCampoAlerta}"
                            IsVisible="{Binding PuedeDeshacerTerminado}" Command="{Binding DeshacerTerminadoCommand}" />
                    <Button Grid.Row="1" Text="Salir" Style="{StaticResource BotonCampo}" Command="{Binding SalirCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- Configuración (el engranaje): las opciones de trabajo de la tablet. Los cambios valen al instante y se recuerdan. -->
        <Grid IsVisible="{Binding HayConfiguracion}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Start" Margin="0,60,0,0">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Configuración" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <Label Text="{Binding NombreEstablecimiento, StringFormat='Preferencias de {0}'}" Style="{StaticResource TextoCampo}" FontSize="16"
                           TextColor="{StaticResource Gray600}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" BackgroundColor="{StaticResource CampoClaro}" Padding="12,10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Llevar control por manga" Style="{StaticResource TextoCampo}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="Contador por manga (7/10), cantidad de vacas, cierre automático y Finalizar manga."
                                   Style="{StaticResource TextoCampo}" FontSize="14" TextColor="{StaticResource Gray600}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding UsaMangas}" VerticalOptions="Center"
                                SemanticProperties.Description="Llevar control por manga" />
                    </Grid>

                    <Button Text="Cerrar" Style="{StaticResource BotonCampo}" HeightRequest="56" FontSize="20"
                            Command="{Binding CerrarConfiguracionCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Cantidad de la manga: cuántas vacas entran, que se pone a mano cada vez que entra una manga. El contador pasa a "7/10". -->
        <Grid IsVisible="{Binding HayCantidadManga}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Start" Margin="0,60,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding NumeroManga, StringFormat='Manga {0}'}" Style="{StaticResource TextoCampo}" FontSize="18" TextColor="{StaticResource Gray600}" />
                    <Label Text="¿Cuántas vacas entran en esta manga?" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <Entry Style="{StaticResource EntradaCampo}" Keyboard="Numeric" MaxLength="3" HeightRequest="64" FontSize="30"
                           Text="{Binding TextoCantidadManga}" Placeholder="Cantidad" HorizontalTextAlignment="Center" />
                    <Border IsVisible="{Binding HayMensajeCuadro}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="12,8">
                        <Label Text="{Binding MensajeCuadro}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    </Border>
                    <Button Text="Guardar" Style="{StaticResource BotonCampo}" HeightRequest="56" FontSize="22"
                            Command="{Binding GuardarCantidadMangaCommand}" />
                    <Button Text="Cancelar" Style="{StaticResource BotonCampoSecundario}" HeightRequest="52" FontSize="20"
                            Command="{Binding CerrarCantidadMangaCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Lista completa de vacas en espera ("+N" de la botonera, RF-2). Un toque abre la ficha de esa vaca. -->
        <Grid IsVisible="{Binding HayListaEspera}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Vacas en espera" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <ScrollView MaximumHeightRequest="480" VerticalScrollBarVisibility="Always">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Esperas}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:EsperaItem">
                                    <!-- Caravana + CVET en la primera línea; hora y tiempo esperando en la segunda. Mínimo 56 dp de alto. -->
                                    <Button Text="{Binding TextoLista}" Style="{StaticResource BotonCampoAlerta}" MinimumHeightRequest="56" FontSize="20"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrabajoViewModel}}, Path=AbrirEsperaCommand, x:DataType=vm:TrabajoViewModel}"
                                            CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Button Text="Cerrar" Style="{StaticResource BotonCampoSecundario}" HeightRequest="52" FontSize="20"
                            Command="{Binding CerrarListaEsperaCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- "Agregar evento": todas las opciones de estado más "Rechazo"; un toque guarda el tacto o el rechazo (RF-15). -->
        <Grid IsVisible="{Binding HayEventos}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Elegí el evento" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <Label Text="{Binding ObservacionPendiente, StringFormat='Se guarda con la observación: {0}'}" IsVisible="{Binding HayObservacionPendiente}"
                           Style="{StaticResource TextoCampo}" FontSize="16" />
                    <!-- Un mensaje (por ejemplo, "ya existe un evento con ese nombre") sobre la lista o el formulario. -->
                    <Border IsVisible="{Binding HayMensajeCuadro}" BackgroundColor="{StaticResource CampoPeligro}" StrokeThickness="0" Padding="12,8">
                        <Label Text="{Binding MensajeCuadro}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    </Border>

                    <!-- Formulario de evento nuevo: por si no existe el que se busca. No guarda ningún tacto: después se elige de la lista. -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HayFormularioEvento}">
                        <Label Text="Evento nuevo" Style="{StaticResource TextoCampo}" FontAttributes="Bold" FontSize="20" />
                        <Entry Text="{Binding NuevoEventoNombre}" Placeholder="Nombre del evento (ej.: Aborto)" MaxLength="40"
                               Style="{StaticResource EntradaCampo}" HeightRequest="56" FontSize="20" />
                        <Entry Text="{Binding NuevoEventoCodigoDc}" Placeholder="Código en Dairy Comp (opcional)" MaxLength="30"
                               Style="{StaticResource EntradaCampo}" HeightRequest="56" FontSize="20" />
                        <Label Text="Si no escribís el código de Dairy Comp, se usa el nombre en mayúsculas. Revisalo: Dairy Comp lo usa al importar."
                               Style="{StaticResource TextoCampo}" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Button Text="Guardar evento" Style="{StaticResource BotonCampo}" HeightRequest="56" FontSize="20"
                                Command="{Binding CrearEventoCommand}" />
                        <Button Text="Cancelar" Style="{StaticResource BotonCampoSecundario}" HeightRequest="52" FontSize="20"
                                Command="{Binding CancelarNuevoEventoCommand}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12" IsVisible="{Binding HayFormularioEvento, Converter={StaticResource Invertir}}">
                    <ctl:SelectorEventosView Selector="{Binding Selector}" NuevoEventoCommand="{Binding AbrirNuevoEventoCommand}" />
                    <Button Text="Cancelar" Style="{StaticResource BotonCampoSecundario}" HeightRequest="52" FontSize="20"
                            IsVisible="{Binding Selector.MostrandoLista}" Command="{Binding CerrarCuadroAgregarCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- "Agregar observación": texto opcional que se guarda con el próximo evento. -->
        <Grid IsVisible="{Binding HayObservacion}" BackgroundColor="{StaticResource CampoVelo}" Padding="14">
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" HorizontalOptions="Fill" VerticalOptions="Start" Margin="0,40,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Agregar observación" Style="{StaticResource TituloCuadro}" FontSize="26" />
                    <Label Text="Opcional. Se guarda junto con el próximo evento que elijas." Style="{StaticResource TextoCampo}" FontSize="16" />
                    <Editor Text="{Binding TextoObservacion}" Placeholder="Escribí la observación" MaxLength="300"
                            HeightRequest="140" FontSize="20" TextColor="Black" BackgroundColor="{StaticResource CampoClaro}"
                            AutoSize="Disabled" />
                    <Button Text="Guardar observación" Style="{StaticResource BotonCampo}" HeightRequest="56" FontSize="20"
                            Command="{Binding GuardarObservacionCommand}" />
                    <Button Text="Cancelar" Style="{StaticResource BotonCampoSecundario}" HeightRequest="52" FontSize="20"
                            Command="{Binding CerrarCuadroAgregarCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
